{
  "maxRows": 8,
  "historyLimit": 100,
  "historySuggestionLimit": 5,
  "fileLimit": 50,
  "enableTabCompletions": true,
  "enableCdTree": true,
  "lsTreeDepth": 1,
  "lsTreeLimit": 50,
  "borderStyle": "single",
  "enableUpdateCheck": true,
  "updateCheckInterval": 86400,
  "keyTimeout": 1,
  "showTypedOption": true,
  "historyStopPrefixes": [
    "git commit -m \""
  ],
  "rejectedCommandResponsePatterns": [
    "command not found"
  ],
  "customSnippets": [
    {
      "trigger": "gpush",
      "command": "git push origin \"$(git_current_branch)\""
    },
    {
      "trigger": "gpull",
      "command": "git pull origin \"$(git_current_branch)\""
    }
  ]
}
